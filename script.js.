    "another one.",
    "again.",
    "keep going.",
    "surprise me.",
    "next.",
    "show me something.",
    "still curious?"
];

function randomButton() {
    button.textContent =
        buttonTexts[Math.floor(Math.random() * buttonTexts.length)];
}

