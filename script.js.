// Secret Dark Mode
let secretClicks = 0;

title.addEventListener("click", () => {
    secretClicks++;

    if (secretClicks >= 7) {
        dark = !dark;

        document.body.classList.toggle("dark");

        secretClicks = 0;
    }
});
